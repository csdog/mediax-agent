{
  "openapi": "3.0.3",
  "info": {
    "title": "MediaX Desktop Control API",
    "version": "0.0.1",
    "description": "Local Agent control API for MediaX desktop (loopback + bearer token)."
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "token"
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "example": true
          },
          "version": {
            "type": "string",
            "nullable": true,
            "example": "0.2.0"
          }
        },
        "required": [
          "ok"
        ]
      },
      "Account": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "platform": {
            "type": "string",
            "enum": [
              "douyin",
              "kuaishou",
              "channels",
              "xiaohongshu",
              "bilibili",
              "baijiahao",
              "toutiao",
              "weibo",
              "zhihu",
              "qq",
              "sohu",
              "yidian",
              "dayu",
              "netease",
              "iqiyi",
              "weishi",
              "wechat",
              "sohuvideo",
              "pipixia",
              "tencentvideo",
              "duoduo",
              "meipai",
              "acfun",
              "kuaichuan",
              "xueqiu",
              "fengwang",
              "dewu",
              "jd",
              "douban",
              "csdn",
              "jianshu",
              "chejia",
              "xhsmerchant",
              "yiche",
              "dongche",
              "ximalaya",
              "xiaoyuzhou",
              "guanghe",
              "xhsdm",
              "tiktok",
              "youtube",
              "facebook",
              "instagram",
              "reddit",
              "threads",
              "twitter",
              "linkedin",
              "pinterest",
              "alipay",
              "hupu",
              "zsxq",
              "music163",
              "qqmusic",
              "qingting",
              "lizhi",
              "googlebusiness"
            ]
          },
          "login": {
            "type": "string",
            "enum": [
              "unchecked",
              "logged_out",
              "logged_in",
              "needs_verification"
            ]
          },
          "targets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PublishTarget"
            }
          },
          "message": {
            "type": "string"
          },
          "avatar": {
            "type": "string"
          },
          "supportedKinds": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "article",
                "moment",
                "video",
                "audio"
              ]
            }
          }
        },
        "required": [
          "id",
          "name",
          "platform",
          "login",
          "targets",
          "supportedKinds"
        ]
      },
      "PublishTarget": {
        "type": "object",
        "properties": {
          "accountId": {
            "type": "string",
            "minLength": 1
          },
          "identityId": {
            "type": "string",
            "pattern": "^\\d+$"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/TargetKind"
          }
        },
        "required": [
          "accountId",
          "identityId",
          "name",
          "kind"
        ]
      },
      "TargetKind": {
        "type": "string",
        "enum": [
          "profile",
          "page"
        ]
      },
      "ControlError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "Task": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "contentKind": {
            "type": "string",
            "enum": [
              "article",
              "moment",
              "video",
              "audio"
            ]
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "body": {
            "type": "string"
          },
          "images": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "createdAt": {
            "type": "string"
          },
          "scheduledAt": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "contentKind",
          "title",
          "body",
          "images",
          "createdAt"
        ]
      },
      "TaskTarget": {
        "allOf": [
          {
            "$ref": "#/components/schemas/PublishTarget"
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "taskId": {
                "type": "string"
              },
              "status": {
                "$ref": "#/components/schemas/TargetStatus"
              },
              "error": {
                "type": "string",
                "nullable": true
              },
              "url": {
                "type": "string",
                "nullable": true
              }
            },
            "required": [
              "id",
              "taskId",
              "status",
              "error",
              "url"
            ]
          }
        ]
      },
      "TargetStatus": {
        "type": "string",
        "enum": [
          "scheduled",
          "pending",
          "running",
          "awaiting_user",
          "submitted",
          "verified",
          "failed",
          "unknown"
        ]
      },
      "TaskDetail": {
        "type": "object",
        "properties": {
          "task": {
            "$ref": "#/components/schemas/Task"
          },
          "targets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TaskTarget"
            }
          }
        },
        "required": [
          "task",
          "targets"
        ]
      },
      "PublishInput": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "article",
              "moment",
              "video",
              "audio"
            ]
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "body": {
            "type": "string",
            "maxLength": 500000,
            "default": ""
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "maxItems": 30,
            "default": []
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "accountId": {
                  "type": "string",
                  "minLength": 1
                },
                "identityId": {
                  "type": "string",
                  "pattern": "^\\d+$"
                },
                "kind": {
                  "$ref": "#/components/schemas/TargetKind"
                }
              },
              "required": [
                "accountId",
                "identityId",
                "kind"
              ]
            },
            "minItems": 1,
            "maxItems": 100
          },
          "scheduledAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          }
        },
        "required": [
          "kind",
          "targets"
        ],
        "additionalProperties": false
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "healthGet",
        "summary": "Control API health",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        }
      }
    },
