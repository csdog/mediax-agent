    "/targets/{id}/{action}": {
      "post": {
        "operationId": "targetAction",
        "summary": "Retry a failed target, resume after user action, or verify a submitted target",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "required": true,
            "name": "id",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "retry",
                "resume",
                "verify"
              ]
            },
            "required": true,
            "name": "action",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TaskDetail"
                }
              }
            }
          },
          "400": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ControlError"
                }
              }
            }
          },
          "401": {
            "description": "OK",
            "content": {
