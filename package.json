{
  "name": "mediax-agent",
  "version": "0.4.0",
  "private": false,
  "description": "MediaX Agent CLI (Skill / MCP later): talk to local MediaX desktop",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/csdog/mediax-agent.git"
  },
  "bin": {
    "mediax-cli": "./skills/bin/mediax-cli",
    "mxc": "./skills/bin/mxc"
  },
  "type": "module",
  "scripts": {
    "mediax-cli": "bun run src/cli.ts",
    "mxc": "bun run src/cli.ts",
    "doctor": "bun run src/cli.ts doctor",
    "generate:api": "node ./node_modules/@openapi-codegen/cli/lib/cli.js gen desktop",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun build ./src/cli.ts --compile --outfile dist/mediax-cli && cp dist/mediax-cli dist/mxc && rm -rf dist/skills && cp -R skills dist/skills"
  },
  "dependencies": {
    "citty": "^0.2.2"
  },
  "devDependencies": {
    "@openapi-codegen/cli": "^3.1.0",
    "@openapi-codegen/typescript": "^11.1.0",
    "@types/bun": "^1.4.3",
    "typescript": "7.0.2"
  }
}
